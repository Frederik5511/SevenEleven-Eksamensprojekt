<Window x:Class="SevenEleven.WPF.Views.CreateProductView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opret produkt"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <StackPanel Margin="20">
            <Label Content="Produktnavn"/>
            <TextBox Width="300"
                     HorizontalAlignment="Left"
                     MaxLength="100"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            
            <Label Content="Stregkode" Margin="0,10,0,0"/>
            <TextBox Width="300"
                     HorizontalAlignment="Left"
                     MaxLength="50"
                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"/>
            
            <Label Content="Indkøbspris (kr.)" Margin="0,10,0,0"/>
            <TextBox Width="300"
                     HorizontalAlignment="Left"
                     Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Salgspris (kr.)" Margin="0,10,0,0"/>
            <TextBox Width="300"
                     HorizontalAlignment="Left"
                     Text="{Binding SellingPriceText, UpdateSourceTrigger=PropertyChanged}"/>

            <Label Content="Holdbarhed (dage)" Margin="0,10,0,0"/>
            <TextBox Width="300"
                     HorizontalAlignment="Left"
                     Text="{Binding ShelfLifeText, UpdateSourceTrigger=PropertyChanged}"/>

            <CheckBox Content="Sæsonvare"
                      Margin="0,15,0,0"
                      IsChecked="{Binding IsSeasonal}"/>

            <Label Content="Produktkategori (valgfri)" Margin="0,10,0,0"/>
            <ComboBox Width="300"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding Categories}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="ProductCategoryId"
                      SelectedValue="{Binding ProductCategoryId}"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="DarkRed"
                       MaxWidth="300"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SuccessMessage}"
                       Foreground="DarkGreen"
                       MaxWidth="300"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Annuller"
                        IsCancel="True"
                        Padding="12,4"
                        Margin="0,0,8,0"/>

                <Button Content="Gem"
                        Command="{Binding SaveCommand}"
                        Padding="12,4"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>