<Window x:Class="SevenEleven.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SevenEleven.WPF.Views"
        Title="7-Eleven Lagerstyring"
        Height="800"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TabControl>
            <TabItem Header="Lager"><views:InventoryView x:Name="InventoryView"/></TabItem>
            <TabItem Header="Bestilling"><views:OrderView x:Name="OrderView"/></TabItem>
            <TabItem Header="Varemodtagelse"><views:ReceivingView x:Name="ReceivingView"/></TabItem>
        </TabControl>
    </Grid>

</Window>
